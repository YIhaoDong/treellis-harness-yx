# Frontend (Vercel). Public value: it is compiled into the browser bundle.
# Leave unset locally to use http://localhost:3001.
VITE_API_BASE=https://api.treellis.art

# Generation server (Render, set in render.yaml). Setting it switches the server to public mode:
# CORS limited to these origins, local key and draft/commit endpoints disabled.
ALLOWED_ORIGINS=https://treellis.art,https://www.treellis.art

# Do not set OPENAI_API_KEY on a public server. Users enter their own key in the app,
# or sign in for free generations (README.md "Free accounts"), which need all four of:
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...        # secret: Render dashboard only
ACCOUNT_OPENAI_API_KEY=sk-...            # secret: the lab key used for free generations
FREE_GENERATIONS=3                       # per account, in total; failed runs are given back
FREE_EFFORTS=low,medium,high             # efforts allowed on the lab key
FREE_ATTEMPTS=10                         # runs one account may start, counting refunded failures
SIGN_IN_CODE_LENGTH=8                    # digits in the emailed code (Supabase Email OTP Length)
MAX_ACTIVE_GENERATIONS=4                 # generations running at once on the server
